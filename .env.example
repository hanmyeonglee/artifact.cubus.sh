# Initial active admin account created on first boot when no admin exists yet.
# Password must be 12..128 bytes and must not start with replace-with-.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional (Phase 2 admin.cubus.sh): set a random Bearer token to enable the
# internal-only :9090 Admin API listener (disabled when unset).
# ADMIN_API_TOKEN=replace-with-a-random-admin-api-token
